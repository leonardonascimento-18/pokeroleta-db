<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PokéRoleta</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Press+Start+2P&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        ::-webkit-scrollbar { width: 0px; background: transparent; }

        @keyframes spin-blur {
            0% { transform: scale(0.9) rotate(-10deg); filter: blur(2px); opacity: 0.8; }
            50% { transform: scale(1.1) rotate(10deg); filter: blur(0px); opacity: 1; }
            100% { transform: scale(0.9) rotate(-10deg); filter: blur(2px); opacity: 0.8; }
        }
        .anim-spinning { animation: spin-blur 0.15s infinite; }
        
        @keyframes pop {
            0% { transform: scale(0); opacity: 0; }
            80% { transform: scale(1.1); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }
        .anim-pop { animation: pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }

        @keyframes pokeball-throw {
            0% { transform: translateY(150px) scale(0.2) rotate(-360deg); opacity: 0; }
            50% { transform: translateY(-30px) scale(1.2) rotate(0deg); opacity: 1; }
            100% { transform: translateY(0) scale(1); opacity: 1; }
        }
        .anim-throw { animation: pokeball-throw 0.6s ease-out forwards; }

        @keyframes pokeball-shake {
            0%, 100% { transform: translateX(0) rotate(0); }
            20% { transform: translateX(-10px) rotate(-15deg); }
            40% { transform: translateX(10px) rotate(15deg); }
            60% { transform: translateX(-10px) rotate(-10deg); }
            80% { transform: translateX(10px) rotate(10deg); }
        }
        .anim-shake { animation: pokeball-shake 0.8s ease-in-out infinite; }

        .pokeball-css {
            width: 80px; height: 80px;
            background: linear-gradient(to bottom, #ef4444 48%, #000 48%, #000 52%, #fff 52%);
            border-radius: 50%;
            border: 4px solid #000;
            position: relative;
            box-shadow: inset -5px -5px 15px rgba(0,0,0,0.3), 0 10px 15px rgba(0,0,0,0.4);
            margin: 0 auto;
        }
        .pokeball-css::after {
            content: '';
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 20px; height: 20px;
            background: #fff;
            border: 3px solid #000;
            border-radius: 50%;
        }

        .view-section { display: none; }
        .view-section.active { display: flex; }
        .tab-btn.active { color: #ef4444; border-top-color: #ef4444; background-color: #fef2f2; }
        .silhouette { filter: brightness(0) invert(0.8); opacity: 0.5; }
    </style>
</head>
<body class="flex justify-center h-[100dvh] items-center text-gray-800">

    <div class="w-full max-w-md h-full sm:h-[90vh] sm:rounded-3xl bg-gray-50 flex flex-col relative overflow-hidden shadow-2xl sm:border-8 border-gray-900">
        
        <!-- Header -->
        <header class="bg-red-600 text-white p-3 shadow-md z-20 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="w-4 h-4 rounded-full border-2 border-white bg-blue-400"></div>
                <h1 class="text-sm font-black italic tracking-wide" style="font-family: 'Press Start 2P', monospace;">POKÉROLETA</h1>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="openSettings()" class="text-xs bg-black/20 hover:bg-black/40 p-2 rounded-full font-bold transition">⚙️</button>
                <button onclick="resetGame()" class="text-[9px] bg-black/20 hover:bg-black/40 px-2.5 py-1.5 rounded-full font-bold transition uppercase">Reiniciar</button>
            </div>
        </header>

        <!-- Modal de Configurações & Acessibilidade -->
        <div id="modal-settings" class="absolute inset-0 bg-black/70 z-50 hidden flex items-center justify-center p-4">
            <div class="bg-white w-full max-w-sm max-h-full overflow-y-auto rounded-3xl p-6 shadow-2xl flex flex-col gap-4">
                <div class="flex justify-between items-center border-b pb-2">
                    <h3 class="font-black text-lg text-gray-800">Configurações & Acessibilidade</h3>
                    <button onclick="closeSettings()" class="text-gray-400 font-bold text-xl">&times;</button>
                </div>
                <div class="flex flex-col gap-3">
                    <div>
                        <label class="text-xs font-bold text-gray-600 block mb-1">Tamanho da Legenda (Fonte)</label>
                        <select id="setting-font-size" onchange="changeFontSize(this.value)" class="w-full bg-gray-100 border border-gray-300 rounded-xl p-2.5 text-xs font-bold text-gray-800 outline-none">
                            <option value="normal">Normal</option>
                            <option value="large">Grande (+20%)</option>
                            <option value="xlarge">Muito Grande (+40%)</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs font-bold text-gray-600 block mb-1">Tamanho da Barra de Navegação</label>
                        <select id="setting-nav-size" onchange="changeNavSize(this.value)" class="w-full bg-gray-100 border border-gray-300 rounded-xl p-2.5 text-xs font-bold text-gray-800 outline-none">
                            <option value="normal">Normal</option>
                            <option value="large">Grande (Fácil Toque)</option>
                        </select>
                    </div>
                    <div class="border-t border-gray-200 pt-3">
                        <label class="text-xs font-bold text-gray-600 block mb-2">Áudio</label>
                        <button id="btn-mute" onclick="toggleMute()" class="w-full rounded-xl p-2.5 text-xs font-black border transition-colors">🔊 Som ligado</button>
                        <div class="flex items-center gap-2 mt-3">
                            <button onclick="changeVolume(-10)" aria-label="Diminuir volume" class="w-10 h-10 shrink-0 rounded-xl bg-gray-200 text-gray-800 font-black text-xl leading-none active:bg-gray-300">−</button>
                            <input id="setting-volume" type="range" min="0" max="100" step="5" value="70" aria-label="Volume" oninput="setVolume(this.value)" onchange="Sound.play('tap')" class="flex-1 min-w-0 accent-red-600">
                            <button onclick="changeVolume(10)" aria-label="Aumentar volume" class="w-10 h-10 shrink-0 rounded-xl bg-gray-200 text-gray-800 font-black text-xl leading-none active:bg-gray-300">+</button>
                        </div>
                        <div class="text-center text-xs font-bold text-gray-500 mt-1">Volume: <span id="volume-label">70%</span></div>
                    </div>
                </div>
                <button onclick="closeSettings()" class="w-full bg-red-600 text-white font-black py-3 rounded-xl shadow mt-2">Salvar & Fechar</button>
            </div>
        </div>

        <!-- Loading -->
        <div id="loading-screen" class="absolute inset-0 bg-white z-50 flex flex-col items-center justify-center">
            <div class="pokeball-css anim-shake mb-4"></div>
            <p class="font-bold text-gray-500 animate-pulse">Carregando PokéRoleta...</p>
        </div>

        <!-- Conteúdo Principal -->
        <main class="flex-1 overflow-y-auto relative pb-20 bg-gradient-to-b from-gray-50 to-gray-200">
            
            <!-- VIEW 1: ROLETA -->
            <div id="view-roulette" class="view-section active flex-col items-center justify-center p-6 h-full">
                <div class="absolute top-3 left-4 bg-red-100 border-2 border-red-300 px-3 py-1 rounded-full flex items-center gap-1 shadow-sm">
                    <span class="text-xs">⚪</span>
                    <span id="player-balls" class="text-xs font-black text-red-800">5</span>
                </div>
                <div class="absolute top-3 right-4 bg-yellow-100 border-2 border-yellow-400 px-3 py-1 rounded-full flex items-center gap-1 shadow-sm">
                    <span class="text-xs">🪙</span>
                    <span id="player-money" class="text-xs font-black text-yellow-800">1000</span>
                </div>

                <div class="text-center mb-6">
                    <h2 class="text-2xl font-black text-gray-800">Encontro Selvagem!</h2>
                    <p class="text-xs text-gray-500 mt-1">Gire para encontrar um Pokémon</p>
                </div>

                <div class="w-56 h-56 bg-white rounded-full border-8 border-gray-200 shadow-inner flex items-center justify-center relative mb-6 z-10">
                    <img id="roulette-img" src="" class="w-36 h-36 object-contain z-10 drop-shadow-2xl hidden" alt="Pokemon">
                    <div id="roulette-placeholder" class="text-7xl font-black text-gray-200 z-10">?</div>
                    <div id="capture-pokeball" class="pokeball-css absolute z-20 hidden"></div>
                </div>

                <div id="roulette-info" class="mb-6 opacity-0 transition-opacity duration-300 text-center">
                    <h3 id="roulette-name" class="text-2xl font-black text-gray-800 capitalize">???</h3>
                    <div class="bg-gray-800 text-white text-[10px] font-bold px-3 py-1 rounded-full inline-block mt-2">
                        Poder Base: <span id="roulette-pwr" class="text-yellow-400">0</span>
                    </div>
                </div>

                <div class="flex flex-col gap-3 w-full">
                    <button id="btn-spin" onclick="startSpin()" class="w-full bg-blue-500 text-white font-black py-4 rounded-2xl shadow-[0_6px_0_#1d4ed8] active:translate-y-[6px] active:shadow-none transition-all text-lg uppercase tracking-wider">
                        GIRAR!
                    </button>
                    <div id="catch-panel" class="hidden flex-col gap-2 w-full"></div>
                </div>
            </div>

            <!-- VIEW 2: POKÉDEX -->
            <div id="view-pokedex" class="view-section flex-col p-4 min-h-full">
                <div class="flex justify-between items-end mb-3 border-b-2 border-gray-300 pb-2">
                    <div>
                        <h2 class="font-black text-xl text-gray-800">Pokédex Global</h2>
                        <span class="text-xs font-bold text-blue-600 mt-1">Registrados: <span id="pokedex-count">0</span> / 1025</span>
                    </div>
                    <select id="gen-select" onchange="setGenFilter(this.value)" class="text-xs font-bold px-2 py-1.5 rounded-lg bg-gray-800 text-white shadow outline-none">
                        <option value="1">Geração 1 (Kanto)</option>
                        <option value="2">Geração 2 (Johto)</option>
                        <option value="3">Geração 3 (Hoenn)</option>
                        <option value="4">Geração 4 (Sinnoh)</option>
                        <option value="5">Geração 5 (Unova)</option>
                        <option value="6">Geração 6 (Kalos)</option>
                        <option value="7">Geração 7 (Alola)</option>
                        <option value="8">Geração 8 (Galar)</option>
                        <option value="9">Geração 9 (Paldea)</option>
                        <option value="all">Todas</option>
                    </select>
                </div>
                <div id="pokedex-grid" class="grid grid-cols-4 sm:grid-cols-5 gap-2 pb-6"></div>
            </div>

            <!-- VIEW 3: EQUIPE -->
            <div id="view-team" class="view-section flex-col p-4 min-h-full">
                <div class="bg-gray-800 rounded-2xl p-4 mb-5 text-white shadow-lg">
                    <div class="flex justify-between items-end mb-3">
                        <h2 class="font-black text-base">Equipe Ativa</h2>
                        <span class="text-xs text-gray-400 font-bold" id="team-power-total">Poder: 0</span>
                    </div>
                    <div id="team-slots" class="flex justify-between gap-2"></div>
                </div>
                <div class="border-b-2 border-gray-300 pb-2 mb-3 flex justify-between items-end">
                    <h2 class="font-black text-lg text-gray-800">Caixa de Capturados</h2>
                    <span class="text-xs font-bold text-gray-500" id="box-count">0 Pokémons</span>
                </div>
                <div id="box-grid" class="grid grid-cols-4 sm:grid-cols-5 gap-2 pb-6"></div>
            </div>

            <!-- VIEW 4: ITENS & LOJA -->
            <div id="view-items" class="view-section flex-col p-4 min-h-full">
                <div class="border-b-2 border-gray-300 pb-2 mb-3 flex justify-between items-center">
                    <h2 class="font-black text-xl text-gray-800">Loja & Inventário</h2>
                    <span class="text-xs font-bold text-yellow-600">Saldo: <span id="shop-money">1000</span> 🪙</span>
                </div>
                <h3 class="font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Comprar Itens</h3>
                <div id="shop-grid" class="grid grid-cols-1 gap-2 mb-5"></div>
                <h3 class="font-bold text-xs text-gray-500 uppercase tracking-wider mb-2">Seu Inventário</h3>
                <div id="items-obtained-grid" class="grid grid-cols-1 gap-2 pb-6"></div>
            </div>

            <!-- VIEW 5: GINÁSIOS -->
            <div id="view-gyms" class="view-section flex-col p-4 min-h-full">
                <div class="flex justify-between items-end mb-4 border-b-2 border-gray-300 pb-2">
                    <h2 class="font-black text-xl text-gray-800">Arenas & Eventos</h2>
                    <span class="text-sm font-bold text-yellow-600 bg-yellow-100 px-2.5 py-1 rounded-lg">Insígnias: <span id="badge-count">0</span>/8</span>
                </div>
                <div class="flex gap-2 mb-4">
                    <button onclick="switchGymTab('gyms')" id="gym-tab-btn" class="flex-1 py-2 font-black text-xs rounded-xl bg-blue-600 text-white shadow">Ginásios</button>
                    <button onclick="switchGymTab('events')" id="event-tab-btn" class="flex-1 py-2 font-black text-xs rounded-xl bg-gray-200 text-gray-700">Eventos</button>
                </div>
                <div id="gym-list" class="flex flex-col gap-3 pb-6"></div>
            </div>
        </main>

        <!-- Navbar Dinâmica -->
        <nav id="main-navbar" class="bg-white border-t-2 border-gray-200 flex absolute bottom-0 w-full z-20">
            <button onclick="switchTab('roulette')" id="tab-roulette" class="tab-btn active flex-1 py-2.5 flex flex-col items-center gap-0.5 text-gray-400 border-t-4 border-transparent transition-colors">
                <span class="nav-label text-[9px] font-black uppercase">Roleta</span>
            </button>
            <button onclick="switchTab('pokedex')" id="tab-pokedex" class="tab-btn flex-1 py-2.5 flex flex-col items-center gap-0.5 text-gray-400 border-t-4 border-transparent transition-colors">
                <span class="nav-label text-[9px] font-black uppercase">Pokédex</span>
            </button>
            <button onclick="switchTab('team')" id="tab-team" class="tab-btn flex-1 py-2.5 flex flex-col items-center gap-0.5 text-gray-400 border-t-4 border-transparent transition-colors">
                <span class="nav-label text-[9px] font-black uppercase">Equipe</span>
            </button>
            <button onclick="switchTab('items')" id="tab-items" class="tab-btn flex-1 py-2.5 flex flex-col items-center gap-0.5 text-gray-400 border-t-4 border-transparent transition-colors">
                <span class="nav-label text-[9px] font-black uppercase">Itens</span>
            </button>
            <button onclick="switchTab('gyms')" id="tab-gyms" class="tab-btn flex-1 py-2.5 flex flex-col items-center gap-0.5 text-gray-400 border-t-4 border-transparent transition-colors">
                <span class="nav-label text-[9px] font-black uppercase">Ginásios</span>
            </button>
        </nav>

        <!-- Modal Batalha -->
        <div id="modal-battle" class="absolute inset-0 bg-black/90 z-50 hidden flex-col">
            <div class="bg-gray-800 text-white p-3 flex justify-between items-center shadow-md">
                <h3 id="battle-title" class="font-black text-sm text-yellow-400">Batalha</h3>
                <button onclick="closeBattle()" class="text-gray-400 hover:text-white font-bold text-xl leading-none">&times;</button>
            </div>
            <div class="flex-1 flex flex-col p-4 relative">
                <div class="bg-blue-100 rounded-2xl p-4 shadow-inner mb-3 relative overflow-hidden h-52 flex items-center justify-between border-4 border-gray-300">
                    <div class="flex flex-col items-center w-5/12 z-10">
                        <span id="battle-player-name" class="bg-blue-600 text-white text-[9px] font-bold px-2 py-0.5 rounded-lg mb-1 w-full text-center truncate">PLAYER</span>
                        <div class="w-full bg-gray-300 h-2 rounded-full mb-1 overflow-hidden border border-gray-400">
                            <div id="battle-player-hp-bar" class="bg-green-500 h-full transition-all" style="width: 100%"></div>
                        </div>
                        <span id="battle-player-hp-text" class="text-[8px] font-black text-gray-700 mb-2">100/100</span>
                        <img id="battle-player-img" src="" class="w-20 h-20 object-contain drop-shadow-xl" alt="Player">
                    </div>
                    <div class="text-2xl font-black italic text-red-500 opacity-40 absolute left-1/2 -translate-x-1/2">VS</div>
                    <div class="flex flex-col items-center w-5/12 z-10">
                        <span id="battle-enemy-name" class="bg-red-600 text-white text-[9px] font-bold px-2 py-0.5 rounded-lg mb-1 w-full text-center truncate">LÍDER</span>
                        <div class="w-full bg-gray-300 h-2 rounded-full mb-1 overflow-hidden border border-gray-400">
                            <div id="battle-enemy-hp-bar" class="bg-green-500 h-full transition-all" style="width: 100%"></div>
                        </div>
                        <span id="battle-enemy-hp-text" class="text-[8px] font-black text-gray-700 mb-2">100/100</span>
                        <img id="battle-enemy-img" src="" class="w-20 h-20 object-contain drop-shadow-xl" alt="Enemy">
                    </div>
                </div>
                <div id="battle-log" class="bg-gray-900 text-green-300 font-mono text-[10px] rounded-xl p-2 h-20 overflow-y-auto mb-2"></div>
                <div id="battle-controls" class="grid grid-cols-2 gap-2 mt-auto">
                    <button onclick="battleAttack()" class="bg-red-600 text-white font-black py-3.5 rounded-xl shadow-[0_4px_0_#991b1b] active:translate-y-[4px] active:shadow-none uppercase">Lutar</button>
                    <button id="btn-special" onclick="battleSpecial()" class="bg-gray-500 text-gray-300 font-black py-3.5 rounded-xl uppercase">ESPECIAL 0/3</button>
                    <button onclick="showItems()" class="bg-yellow-500 text-white font-black py-3 rounded-xl uppercase">Itens</button>
                    <button onclick="showSwitch(false)" class="bg-blue-600 text-white font-black py-3 rounded-xl uppercase">Trocar</button>
                </div>
                <div id="battle-sub" class="hidden mt-auto">
                    <d
